// Drogendealer-Reboot – Datenmodell (v2, ADR-022: Datenmodell bei Agent 3)
//
// Fachmodell und Nachvollziehbarkeitskonzept: docs/database/DATA_MODEL.md
// Technische Umsetzung (Constraints, Trigger, Migrationsablauf): backend/docs/DATA_MODELS.md
//
// Grundsätze:
// - Katalogwerte (Waren, Orte, Fahrzeug- und Ausrüstungstypen mit Namen, Preisen, Kapazitäten …)
//   stehen ausschließlich in docs/game-design/parameters.toml. Die Katalogtabellen hier enthalten
//   nur den technischen Schlüssel (`slug`) für Fremdschlüssel und Journale; sie werden beim
//   Start aus den Parametern synchronisiert.
// - Zustand (Geld, Bestände, Marktzustand) ist eine Projektion. Jede Änderung wird in einem
//   append-only Journal festgehalten (ADR-010); UPDATE/DELETE auf Journalen verhindern Trigger.
// - Geld: BigInt in ganzzahligen Cent (ADR-019). Bargeld (`cash`) = Schwarzgeld, mitgeführt;
//   Bankkonto (`bank`) = gewaschenes Geld (ADR-023).
// - Kontolöschung pseudonymisiert den Spieler, Journale bleiben erhalten (ADR-017).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Konten & Auth ─────────────────────────────

enum UserRole {
  PLAYER
  ADMIN
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  username       String    @unique
  passwordHash   String
  role           UserRole  @default(PLAYER)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastLoginAt    DateTime?
  /// Zeitpunkt der Pflicht-Bestätigung "ich bin mindestens 18" bei der Registrierung (ADR-013).
  ageConfirmedAt DateTime

  player        Player?
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────── Spieler & Fortschritt ───────────────────────────

enum PlayerStatus {
  IDLE
  TRAVELING
  IN_COMBAT
  HOSPITAL
  JAIL
  /// Konto gelöscht, Spieler bleibt als pseudonymisierter Akteur in den Journalen (ADR-017).
  DELETED
}

model Player {
  id            String       @id @default(cuid())
  /// null nach Kontolöschung (ADR-017): der Spieler ist vom Login getrennt.
  userId        String?      @unique
  name          String       @unique
  /// Bargeld = Schwarzgeld, mitgeführt, beschlagnahmbar (ADR-023). Projektion des Kontobuchs (CASH).
  cash          BigInt       @default(0)
  /// Bankkonto = gewaschenes Geld (ADR-023). Projektion des Kontobuchs (BANK).
  bank          BigInt       @default(0)
  health        Int          @default(100)
  maxHealth     Int          @default(100)
  level         Int          @default(1)
  experience    Int          @default(0)
  reputation    Int          @default(0)
  currentCityId String?
  status        PlayerStatus @default(IDLE)
  statusUntil   DateTime?
  /// Letzte authentifizierte Anfrage (für "online"-Anzeige, max. 1 Update/Minute).
  lastSeenAt    DateTime?
  deletedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user        User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  currentCity City? @relation(fields: [currentCityId], references: [id], onDelete: SetNull)

  heat                 PlayerCityHeat[]
  inventoryLots        InventoryLot[]
  inventoryMovements   InventoryMovement[]       @relation("InventoryMovementPlayer")
  tradeTransactions    TradeTransaction[]        @relation("TradeTransactionPlayer")
  moneyTransactions    MoneyTransaction[]        @relation("MoneyTransactionPlayer")
  vehicles             Vehicle[]
  travels              Travel[]
  equipment            PlayerEquipment[]
  attacks              Combat[]                  @relation("CombatAttacker")
  defenses             Combat[]                  @relation("CombatDefender")
  combatsWon           Combat[]                  @relation("CombatWinner")
  clanMembership       ClanMember?
  clanInvites          ClanInvite[]              @relation("ClanInviteInvitee")
  sentClanInvites      ClanInvite[]              @relation("ClanInviteInviter")
  clanTreasuryTxs      ClanTreasuryTransaction[] @relation("ClanTreasuryTransactionPlayer")
  /// Journalzeilen, die dieser Spieler als Akteur ausgelöst hat (TD-022).
  actedMoneyTxs        MoneyTransaction[]        @relation("MoneyTransactionActor")
  actedInventoryMoves  InventoryMovement[]       @relation("InventoryMovementActor")
  actedTrades          TradeTransaction[]        @relation("TradeTransactionActor")
  actedClanTreasuryTxs ClanTreasuryTransaction[] @relation("ClanTreasuryTransactionActor")
  sentMessages         Message[]                 @relation("MessageSender")
  receivedMessages     Message[]                 @relation("MessageRecipient")
  notifications        Notification[]

  @@index([currentCityId])
  @@index([status, statusUntil])
  @@index([lastSeenAt])
}

/// Fahndungsdruck (Heat) je Spieler und Stadt, 0 … heat.max (trade.md §2).
model PlayerCityHeat {
  playerId  String
  cityId    String
  heat      Float    @default(0)
  updatedAt DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  city   City   @relation(fields: [cityId], references: [id], onDelete: Restrict)

  @@id([playerId, cityId])
  @@index([cityId])
}

// ─────────────────────────── Katalog (Schlüssel aus parameters.toml) ───────────────────────────

/// Ort: Stadt auf der Erde ([city.*]) oder Ort im Weltraum ([space_location.*]).
model City {
  id   String @id @default(cuid())
  slug String @unique

  marketStates  MarketState[]
  marketChanges MarketStateChange[]
  players       Player[]
  heat          PlayerCityHeat[]
  trades        TradeTransaction[]
  travelsFrom   Travel[]            @relation("TravelFrom")
  travelsTo     Travel[]            @relation("TravelTo")
  combats       Combat[]
}

/// Handelbare Ware ([goods.*]).
model Commodity {
  id   String @id @default(cuid())
  slug String @unique

  marketStates       MarketState[]
  marketChanges      MarketStateChange[]
  inventoryLots      InventoryLot[]
  inventoryMovements InventoryMovement[]
  trades             TradeTransaction[]
}

/// Fahrzeugtyp ([vehicles.*]).
model VehicleType {
  id   String @id @default(cuid())
  slug String @unique

  vehicles Vehicle[]
}

enum EquipmentSlot {
  WEAPON
  ARMOR
}

/// Ausrüstungstyp: Waffe ([weapons.*]) oder Rüstung ([armor.*]).
model EquipmentType {
  id   String        @id @default(cuid())
  slug String        @unique
  slot EquipmentSlot

  owned PlayerEquipment[]
}

// ───────────────────────────────── Markt ─────────────────────────────────

/// Zustand eines Marktes (Ort × Ware), economy.md §2. Preise werden nicht gespeichert,
/// sondern aus Bestand, Rauschen und Ereignis per Formel berechnet.
model MarketState {
  id             String   @id @default(cuid())
  cityId         String
  commodityId    String
  /// Marktbestand S (float, ≥ economy.min_stock).
  stock          Float
  /// Log-Rauschen x des Preises.
  noise          Float    @default(0)
  /// Aktives Ereignis (Schlüssel aus [events.*]) oder null.
  activeEvent    String?
  eventTicksLeft Int      @default(0)
  /// Fortlaufende Version, zählt bei jeder echten Änderung hoch (Trigger, TD-022).
  version        Int      @default(0)
  updatedAt      DateTime @updatedAt

  city      City      @relation(fields: [cityId], references: [id], onDelete: Restrict)
  commodity Commodity @relation(fields: [commodityId], references: [id], onDelete: Restrict)

  @@unique([cityId, commodityId])
  @@index([commodityId])
}

enum MarketChangeCause {
  INITIAL
  TRADE
  TICK
  EVENT
  NPC
  ADMIN
  UNSPECIFIED
}

/// Append-only Journal aller Marktzustands-Änderungen (T-105, GAME_ECONOMY.md §7 T-2/T-6).
/// Wird per DB-Trigger auf "MarketState" geschrieben. Ursache, Referenz und Tick setzt die
/// Anwendung pro Transaktion über setMarketChangeContext() (src/modules/world/market-journal.ts).
model MarketStateChange {
  id                String            @id @default(cuid())
  cityId            String
  commodityId       String
  oldStock          Float?
  newStock          Float
  oldNoise          Float?
  newNoise          Float
  oldEvent          String?
  newEvent          String?
  /// Restdauer des Ereignisses nach der Änderung.
  newEventTicksLeft Int
  cause             MarketChangeCause
  /// Referenz auf den Auslöser, z. B. TradeTransaction-ID (Pflicht bei TRADE).
  refId             String?
  tick              Int
  /// Version des Marktes nach der Änderung (lückenlos je Markt).
  version           Int
  /// Zwischenwerte der Formel, Pflichtschlüssel je Ursache (DATA_MODELS.md).
  detail            Json?
  correlationId     String            @db.Uuid
  seq               BigInt            @unique @default(autoincrement())
  createdAt         DateTime          @default(now())

  city      City      @relation(fields: [cityId], references: [id], onDelete: Restrict)
  commodity Commodity @relation(fields: [commodityId], references: [id], onDelete: Restrict)

  @@unique([cityId, commodityId, version])
  @@index([cityId, commodityId, createdAt])
  @@index([commodityId, createdAt])
  @@index([cause, createdAt])
  @@index([correlationId])
  @@index([refId])
}

// ───────────────────────────────── Geld ─────────────────────────────────

/// Wer eine Journalbuchung ausgelöst hat (G-6, TD-022).
enum ActorType {
  PLAYER
  NPC
  SYSTEM
  ADMIN
}

enum MoneyAccount {
  /// Bargeld (Schwarzgeld)
  CASH
  /// Bankkonto (gewaschen)
  BANK
}

/// Grund einer Geldbewegung = Quelle oder Senke laut docs/balancing/GAME_ECONOMY.md §6.
enum MoneyTransactionReason {
  START_CAPITAL
  TRADE_BUY
  TRADE_SELL
  TRAVEL_FUEL
  TRAVEL_TICKET
  BRIBE
  CONFISCATION
  VEHICLE_BUY
  VEHICLE_SALE
  EQUIPMENT_BUY
  EQUIPMENT_SALE
  CREW
  LOOT_GAINED
  LOOT_LOST
  LAUNDERING
  BUSINESS_INCOME
  BUSINESS_UPKEEP
  CLAN_DEPOSIT
  CLAN_PAYOUT
  CLAN_TAX
  EMERGENCY_LOAN
  LOAN_REPAYMENT
  ACCOUNT_DELETION
  ADMIN
}

/// Append-only Kontobuch aller Geldbewegungen eines Spielers, getrennt nach Konto.
/// Invariante: Σ amount je (Spieler, Konto) = Player.cash bzw. Player.bank.
model MoneyTransaction {
  id            String                 @id @default(cuid())
  playerId      String
  account       MoneyAccount
  amount        BigInt
  balanceAfter  BigInt
  reason        MoneyTransactionReason
  refId         String?
  createdAt     DateTime               @default(now())
  /// Journalkopf (TD-022): fortlaufende Reihenfolge, Tick, Aktion und Akteur aus dem Journalkontext
  /// der Transaktion (set_journal_context). Ohne Kontext lehnt die DB die Zeile ab.
  seq           BigInt                 @unique @default(autoincrement())
  tick          Int                    @default(dbgenerated("(journal_context('app.tick'::text))::integer"))
  correlationId String                 @default(dbgenerated("(journal_context('app.correlation_id'::text))::uuid")) @db.Uuid
  actorType     ActorType              @default(dbgenerated("(journal_context('app.actor_type'::text))::\"ActorType\""))
  actorPlayerId String? // per Trigger aus app.actor_player_id (TD-022)

  player Player  @relation("MoneyTransactionPlayer", fields: [playerId], references: [id], onDelete: Restrict)
  actor  Player? @relation("MoneyTransactionActor", fields: [actorPlayerId], references: [id], onDelete: Restrict)

  @@index([playerId, createdAt])
  @@index([playerId, account])
  @@index([reason, createdAt])
  @@index([correlationId])
  @@index([tick])
}

// ─────────────────────────── Handel & Inventar ───────────────────────────

/// Warenstapel eines Spielers je Kaufzeitpunkt (trade.md §2, für Verderb und Einstandspreis).
model InventoryLot {
  id          String   @id @default(cuid())
  playerId    String
  commodityId String
  quantity    Int
  /// Einstandskosten des verbleibenden Stapels in Cent (für den Durchschnitts-Einkaufspreis).
  costBasis   BigInt   @default(0)
  acquiredAt  DateTime @default(now())

  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  commodity Commodity @relation(fields: [commodityId], references: [id], onDelete: Restrict)

  @@index([playerId, commodityId])
  @@index([commodityId])
}

enum InventoryMovementReason {
  TRADE_BUY
  TRADE_SELL
  SPOILAGE
  CONFISCATION
  LOOT_GAINED
  LOOT_LOST
  PRODUCTION
  ACCOUNT_DELETION
  ADMIN
}

/// Append-only Journal aller Warenein- und -ausgänge eines Spielers.
/// Invariante: Σ delta je (Spieler, Ware) = Σ InventoryLot.quantity.
model InventoryMovement {
  id            String                  @id @default(cuid())
  playerId      String
  commodityId   String
  delta         Int
  quantityAfter Int
  reason        InventoryMovementReason
  refId         String?
  createdAt     DateTime                @default(now())
  /// Journalkopf (TD-022): fortlaufende Reihenfolge, Tick, Aktion und Akteur aus dem Journalkontext
  /// der Transaktion (set_journal_context). Ohne Kontext lehnt die DB die Zeile ab.
  seq           BigInt                  @unique @default(autoincrement())
  tick          Int                     @default(dbgenerated("(journal_context('app.tick'::text))::integer"))
  correlationId String                  @default(dbgenerated("(journal_context('app.correlation_id'::text))::uuid")) @db.Uuid
  actorType     ActorType               @default(dbgenerated("(journal_context('app.actor_type'::text))::\"ActorType\""))
  actorPlayerId String? // per Trigger aus app.actor_player_id (TD-022)

  player    Player    @relation("InventoryMovementPlayer", fields: [playerId], references: [id], onDelete: Restrict)
  actor     Player?   @relation("InventoryMovementActor", fields: [actorPlayerId], references: [id], onDelete: Restrict)
  commodity Commodity @relation(fields: [commodityId], references: [id], onDelete: Restrict)

  @@index([playerId, createdAt])
  @@index([playerId, commodityId])
  @@index([commodityId])
  @@index([correlationId])
  @@index([tick])
}

enum TradeSide {
  BUY
  SELL
}

/// Append-only Journal aller Handelsvorgänge.
model TradeTransaction {
  id            String    @id @default(cuid())
  playerId      String
  cityId        String
  commodityId   String
  side          TradeSide
  quantity      Int
  unitPrice     BigInt
  total         BigInt
  createdAt     DateTime  @default(now())
  /// Journalkopf (TD-022): fortlaufende Reihenfolge, Tick, Aktion und Akteur aus dem Journalkontext
  /// der Transaktion (set_journal_context). Ohne Kontext lehnt die DB die Zeile ab.
  seq           BigInt    @unique @default(autoincrement())
  tick          Int       @default(dbgenerated("(journal_context('app.tick'::text))::integer"))
  correlationId String    @default(dbgenerated("(journal_context('app.correlation_id'::text))::uuid")) @db.Uuid
  actorType     ActorType @default(dbgenerated("(journal_context('app.actor_type'::text))::\"ActorType\""))
  actorPlayerId String? // per Trigger aus app.actor_player_id (TD-022)

  player    Player    @relation("TradeTransactionPlayer", fields: [playerId], references: [id], onDelete: Restrict)
  actor     Player?   @relation("TradeTransactionActor", fields: [actorPlayerId], references: [id], onDelete: Restrict)
  city      City      @relation(fields: [cityId], references: [id], onDelete: Restrict)
  commodity Commodity @relation(fields: [commodityId], references: [id], onDelete: Restrict)

  @@index([playerId, createdAt])
  @@index([cityId, commodityId, createdAt])
  @@index([commodityId])
  @@index([correlationId])
  @@index([tick])
}

// ─────────────────────────── Reisen & Fahrzeuge ───────────────────────────

model Vehicle {
  id            String   @id @default(cuid())
  playerId      String
  vehicleTypeId String
  condition     Int      @default(100)
  isActive      Boolean  @default(false)
  purchasedAt   DateTime @default(now())

  player      Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  vehicleType VehicleType @relation(fields: [vehicleTypeId], references: [id], onDelete: Restrict)
  travels     Travel[]

  @@index([playerId])
  @@index([vehicleTypeId])
}

enum TravelStatus {
  IN_PROGRESS
  ARRIVED
  CANCELLED
}

model Travel {
  id         String       @id @default(cuid())
  playerId   String
  vehicleId  String?
  fromCityId String
  toCityId   String
  departedAt DateTime     @default(now())
  arrivesAt  DateTime
  status     TravelStatus @default(IN_PROGRESS)

  player   Player   @relation(fields: [playerId], references: [id], onDelete: Restrict)
  vehicle  Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  fromCity City     @relation("TravelFrom", fields: [fromCityId], references: [id], onDelete: Restrict)
  toCity   City     @relation("TravelTo", fields: [toCityId], references: [id], onDelete: Restrict)

  @@index([playerId, status])
  @@index([status, arrivesAt])
  @@index([vehicleId])
  @@index([fromCityId])
  @@index([toCityId])
}

// ───────────────────────────────── Kampf ─────────────────────────────────

model PlayerEquipment {
  id              String   @id @default(cuid())
  playerId        String
  equipmentTypeId String
  equipped        Boolean  @default(false)
  acquiredAt      DateTime @default(now())

  player        Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  equipmentType EquipmentType @relation(fields: [equipmentTypeId], references: [id], onDelete: Restrict)

  @@index([playerId])
  @@index([equipmentTypeId])
}

enum CombatStatus {
  PENDING
  RESOLVED
}

model Combat {
  id         String       @id @default(cuid())
  attackerId String
  defenderId String
  cityId     String
  status     CombatStatus @default(PENDING)
  winnerId   String?
  loot       BigInt       @default(0)
  /// Rundenprotokoll des Kampfes (Format wird mit dem Kampfsystem festgelegt).
  log        Json?
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  attacker Player  @relation("CombatAttacker", fields: [attackerId], references: [id], onDelete: Restrict)
  defender Player  @relation("CombatDefender", fields: [defenderId], references: [id], onDelete: Restrict)
  winner   Player? @relation("CombatWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  city     City    @relation(fields: [cityId], references: [id], onDelete: Restrict)

  @@index([attackerId, createdAt])
  @@index([defenderId, createdAt])
  @@index([winnerId])
  @@index([cityId])
}

// ─────────────────────────── Clans & Soziales ───────────────────────────

model Clan {
  id           String    @id @default(cuid())
  name         String    @unique
  tag          String    @unique
  description  String?
  /// Clan-Kasse Bargeld (schwarz) – Projektion von ClanTreasuryTransaction (CASH).
  treasuryCash BigInt    @default(0)
  /// Clan-Kasse Bankkonto (weiß) – Projektion von ClanTreasuryTransaction (BANK).
  treasuryBank BigInt    @default(0)
  createdAt    DateTime  @default(now())
  /// Aufgelöst (letztes Mitglied gegangen, ADR-017/018). Bleibt für Journale erhalten.
  dissolvedAt  DateTime?

  members              ClanMember[]
  invites              ClanInvite[]
  treasuryTransactions ClanTreasuryTransaction[]
}

/// Pate / Consigliere / Capo / Soldat / Mitläufer (ADR-021; Anzeige-Namen macht das Frontend).
enum ClanRole {
  GODFATHER
  CONSIGLIERE
  CAPO
  SOLDIER
  ASSOCIATE
}

model ClanMember {
  id       String   @id @default(cuid())
  clanId   String
  /// Unique: ein Spieler kann höchstens einem Clan angehören.
  playerId String   @unique
  role     ClanRole @default(ASSOCIATE)
  joinedAt DateTime @default(now())

  clan   Clan   @relation(fields: [clanId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([clanId])
}

enum ClanTreasuryReason {
  DEPOSIT
  PAYOUT
  TAX
  UPGRADE
  DISTRICT
  WAR
  DISSOLUTION
  ADMIN
}

/// Append-only Journal der Clan-Kasse (ADR-018). Endpunkte folgen mit T-309.
/// Invariante: Σ amount je (Clan, Konto) = Clan.treasuryCash bzw. treasuryBank.
model ClanTreasuryTransaction {
  id            String             @id @default(cuid())
  clanId        String
  /// Auslösender Spieler (Einzahlung, Auszahlung …) oder null (Systembuchung).
  playerId      String?
  account       MoneyAccount
  amount        BigInt
  balanceAfter  BigInt
  reason        ClanTreasuryReason
  refId         String?
  createdAt     DateTime           @default(now())
  /// Journalkopf (TD-022): fortlaufende Reihenfolge, Tick, Aktion und Akteur aus dem Journalkontext
  /// der Transaktion (set_journal_context). Ohne Kontext lehnt die DB die Zeile ab.
  seq           BigInt             @unique @default(autoincrement())
  tick          Int                @default(dbgenerated("(journal_context('app.tick'::text))::integer"))
  correlationId String             @default(dbgenerated("(journal_context('app.correlation_id'::text))::uuid")) @db.Uuid
  actorType     ActorType          @default(dbgenerated("(journal_context('app.actor_type'::text))::\"ActorType\""))
  actorPlayerId String? // per Trigger aus app.actor_player_id (TD-022)

  clan   Clan    @relation(fields: [clanId], references: [id], onDelete: Restrict)
  player Player? @relation("ClanTreasuryTransactionPlayer", fields: [playerId], references: [id], onDelete: Restrict)
  actor  Player? @relation("ClanTreasuryTransactionActor", fields: [actorPlayerId], references: [id], onDelete: Restrict)

  @@index([clanId, createdAt])
  @@index([playerId])
  @@index([correlationId])
  @@index([tick])
}

enum ClanInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model ClanInvite {
  id          String           @id @default(cuid())
  clanId      String
  playerId    String
  invitedById String?
  status      ClanInviteStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  clan      Clan    @relation(fields: [clanId], references: [id], onDelete: Cascade)
  player    Player  @relation("ClanInviteInvitee", fields: [playerId], references: [id], onDelete: Cascade)
  invitedBy Player? @relation("ClanInviteInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([clanId, playerId, status])
  @@index([playerId, status])
  @@index([invitedById])
}

model Message {
  id          String    @id @default(cuid())
  senderId    String?
  recipientId String
  subject     String?
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  sender    Player? @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  recipient Player  @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([senderId])
}

/// Persönliche Benachrichtigung eines Spielers (z. B. "Reise beendet", "Clan-Einladung").
model Notification {
  id        String    @id @default(cuid())
  playerId  String
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, readAt, createdAt])
}

/// Öffentliche Meldung im Live-Ticker (z. B. "X erreicht die Stadt Y").
model TickerEvent {
  id        String   @id @default(cuid())
  type      String
  message   String
  data      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
