NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# PostgreSQL (see ../docker-compose.yml)
DATABASE_URL=postgresql://drogen:drogen@localhost:5432/drogendealer?schema=public
# Separate database used by `npm test` (it gets reset on every test run!)
TEST_DATABASE_URL=postgresql://drogen:drogen@localhost:5432/drogendealer_test?schema=public

# Auth – use a long random value in production (e.g. `openssl rand -hex 48`)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of allowed origins for the frontend, or * in development
CORS_ORIGIN=http://localhost:5173
