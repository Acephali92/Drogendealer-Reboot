# Basis-URL der API (relativ = über Vite-Proxy)
VITE_API_URL=/api/v1
# true: fehlende Spiel-Endpunkte werden im Browser simuliert (MSW)
# all: auch Auth wird simuliert (kein Backend nötig)
# false: alles geht an das echte Backend
VITE_USE_MOCKS=all
# Ziel des Dev-Proxys
VITE_BACKEND_URL=http://localhost:3000
