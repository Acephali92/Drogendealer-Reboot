# Basis-URL der API (relativ = über Vite-Dev-Proxy)
VITE_API_URL=/api/v1
# Mock-Modus (Mock Service Worker im Browser):
#   all    – komplette API simuliert, kein Backend nötig (Standard)
#   hybrid – /auth/* geht an das echte Backend, Spiel-Endpunkte werden simuliert
#   off    – alles geht an das echte Backend
VITE_USE_MOCKS=all
# Ziel des Dev-Proxys für /api
VITE_BACKEND_URL=http://localhost:3000
